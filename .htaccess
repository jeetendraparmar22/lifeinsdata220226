 # BEGIN WordPress
  <IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep the session cookie on one HTTPS origin.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteBase /
  RewriteRule ^index\.php$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.php [L]
  </IfModule>
  # END WordPress

  # php -- BEGIN cPanel-generated handler, do not edit
  # Set the "ea-php83" package as the default "PHP" programming language.
  <IfModule mime_module>
    AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
  </IfModule>
  # php -- END cPanel-generated handler, do not edit

  # BEGIN cPanel-generated php ini directives, do not edit
  # Manual editing of this file may result in unexpected behavior.
  # To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
  # For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
  <IfModule php8_module>
     php_flag display_errors Off
     php_value max_execution_time 60
     php_value max_input_time 60
     php_value max_input_vars 1000
     php_value memory_limit 512M
     php_value post_max_size 516M
     php_value session.gc_maxlifetime 1440
     php_value session.save_path "/home2/nextt3ac/lifeinsdata.com/sessions"
     php_value upload_max_filesize 512M
     php_flag zlib.output_compression Off
  </IfModule>
  <IfModule lsapi_module>
     php_flag display_errors Off
     php_value max_execution_time 60
     php_value max_input_time 60
     php_value max_input_vars 1000
     php_value memory_limit 512M
     php_value post_max_size 516M
     php_value session.gc_maxlifetime 1440
     php_value session.save_path "/home2/nextt3ac/lifeinsdata.com/sessions"
     php_value upload_max_filesize 512M
     php_flag zlib.output_compression Off
  </IfModule>
  # END cPanel-generated php ini directives, do not edit

  # Session cookie settings - REMOVE domain restriction
  <IfModule php8_module>
       php_value session.cookie_path "/"
       php_value session.cookie_domain ""
  </IfModule>

